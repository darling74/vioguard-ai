# Copy this file to ".env" to change settings. Every line is optional.

# --- Server ---
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false              # keep false; true exposes Flask's debug mode
SECRET_KEY=change-me-to-a-long-random-string

# --- Uploads ---
MAX_UPLOAD_MB=200
ALLOWED_EXTENSIONS=mp4,avi,mov
MAX_VIDEO_SECONDS=1800         # longer videos are rejected
MIN_VIDEO_FRAMES=8

# --- Model / inference ---
DEVICE=auto                    # auto | cpu | cuda
TORCH_THREADS=0                # 0 = PyTorch default
INFERENCE_BATCH_SIZE=4
MODEL_PRELOAD=true
# VIOLENCE_THRESHOLD=0.40      # default comes from models/model_config.json (the authors' recalibrated value)
# AGGREGATION=max              # max | mean | topk | consecutive (see README)

# --- Download script ---
# HF_TOKEN=hf_xxx              # only if your network needs an authenticated Hugging Face session
# HF_ENDPOINT=https://huggingface.co   # set to a mirror if huggingface.co is blocked

# --- Logging ---
LOG_LEVEL=INFO
